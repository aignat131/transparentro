# --- Bază de date (docker-compose)
POSTGRES_USER=tro
POSTGRES_PASSWORD=tro
POSTGRES_DB=tro
DB_PORT=5432
API_PORT=8000
WEB_PORT=3000

# --- Acoperire geografică
# Județele importate de ETL (coduri auto separate prin virgulă). "*" = toată țara.
TARGET_COUNTIES=SB
# Județul afișat implicit în interfață
DEFAULT_COUNTY=SB

# --- SEAP (data.gov.ro)
SEAP_YEARS=2025,2026
SEAP_QUARTERS=1,2,3,4
SEAP_KINDS=ad,dan,contracte,atribuire_fara,initiere,modificari

# --- Politețe față de serviciile publice (identificați-vă!)
# Adăugați un contact real (e-mail/URL) înainte de rulări regulate, ex. (...; contact@domeniu.ro)
USER_AGENT=TransparentRO-ETL/0.1 (civic transparency project, Romania)
ANAF_MIN_INTERVAL_S=1.1
NOMINATIM_MIN_INTERVAL_S=1.1
BILANT_MIN_PUBLIC_RON=50000
BILANT_MAX_COMPANIES=400

# --- API / web
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_S=300
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Faza 3: explicații AI (gol = dezactivat)
# Explicații AI: Gemini are prioritate; Claude e folosit doar dacă lipsește cheia Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Faza 3: alerte e-mail. MAIL_PROVIDER=console (doar log) sau smtp
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TransparentRO <alerte@localhost>
SMTP_STARTTLS=true
